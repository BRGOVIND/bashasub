# Copy to .env for local development. Never commit the real file.
# .env is already listed in .gitignore.

# Required. Create at https://aistudio.google.com/apikey
# Sent only as the x-goog-api-key request header, never in a URL.
GEMINI_API_KEY=your-key-here

# Optional overrides.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_MODEL=gemini-2.0-flash
# MAX_RETRIES=3
# TIMEOUT_SECONDS=30
# MAX_TEXT_CHARS=20000

# Debug only. Writes user-submitted text to the log.
# Requires the logger to be at DEBUG level as well. Leave false in production.
# LOG_REQUEST_CONTENT=false
